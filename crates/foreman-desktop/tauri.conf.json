{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foreman",
  "identifier": "app.foreman.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Foreman",
        "width": 1280,
        "height": 800,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb", "rpm"],
    "createUpdaterArtifacts": true,
    "publisher": "Foreman Contributors",
    "license": "GPL-3.0-or-later",
    "category": "Utility",
    "shortDescription": "Print farm manager for Klipper, Bambu and Prusa printers",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEQTc5Q0Y5ODAyMEQ5QTAKUldTZzJTQ0ErWnlublFNZEZhakN2Y3hSaW1oSk1yUFVxSE9GTHZ1NVQzaVgxNWU4L1VvbnhXRFkK",
      "endpoints": [
        "https://github.com/Hellsparks/Foreman/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
